# Postgres (Railway or any). Use the public URL when the app runs outside Railway.
DATABASE_URL="postgresql://user:password@host:5432/railway"

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Optional allowlist: comma-separated emails that can use the web. Empty = anyone who signs in gets their own board.
PARKBOARD_ALLOWED_EMAILS="you@example.com"

# Encrypts what users write (titles, notes, links, project names…) before it reaches Postgres.
# Keyring "id:base64", newest first; generate one with:
#   node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
# Keep it out of the database and its backups: without it the data cannot be read.
PARKBOARD_ENCRYPTION_KEYS=""
# Keys the hash that finds projects by slug. Not rotated with the keyring; base64 of 32 bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PARKBOARD_INDEX_KEY=""
# Only while upgrading an existing board (README, "Upgrading an existing board to encryption").
# PARKBOARD_ENCRYPT_WRITES=false
