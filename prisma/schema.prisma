generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Area {
  PERSONAL
  WORK
}

enum Status {
  IDEA
  PENDING
  DOING
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Kind {
  TASK
  IDEA
  BUG
  RESEARCH
  NOTE
}

/// A group on the canvas. Cards inside it store positions relative to it.
model Project {
  id        String   @id @default(cuid())
  /// Clerk user id. Every board belongs to one user.
  ownerId   String
  slug      String
  name      String
  area      Area     @default(PERSONAL)
  color     String   @default("#68ddfd")
  x         Float    @default(0)
  y         Float    @default(0)
  width     Float    @default(640)
  height    Float    @default(420)
  cards     Card[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, slug])
}

model Card {
  id        String    @id @default(cuid())
  ownerId   String
  /// Short number per owner (#12), easy to say or type when talking to an agent.
  number    Int       @default(0) // assigned by the card_number trigger
  title     String
  notes     String    @default("")
  status    Status    @default(PENDING)
  priority  Priority  @default(MEDIUM)
  kind      Kind      @default(TASK)
  /// Area of a card without project (null = a loose idea, neither personal nor work).
  /// A card in a project uses the project's area.
  area      Area?
  links     Json      @default("[]")
  tags      String[]  @default([])
  /// Who created it: "claude-code", "codex", "web", "cli"…
  origin    String    @default("web")
  /// Summary of the conversation where it was born.
  session   String?
  /// Agent that parked it: "claude-code", "codex"… Detected by the CLI.
  agent     String?
  /// That agent's session id, to resume the conversation.
  sessionId String?
  /// Working directory of that session (Claude Code resumes per directory).
  cwd       String?
  /// Obsidian note, e.g. "Ideas/CLI de Google Flow por ingeniería inversa"
  vaultNote String?
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  x         Float     @default(0)
  y         Float     @default(0)
  doneAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([ownerId, number])
  @@index([ownerId, status])
  @@index([projectId])
}

/// Keys for the CLI and agents. Only the SHA-256 hash is stored.
model ApiKey {
  id         String    @id @default(cuid())
  ownerId    String
  name       String
  prefix     String
  hash       String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([ownerId])
}
