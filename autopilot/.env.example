# Parkboard API (a key created for the autopilot: pnpm key:create autopilot <clerk-user-id>)
PARKBOARD_URL=https://parkboard.jato.run
PARKBOARD_API_KEY=pk_...
# Claude plan token from `claude setup-token` (one year)
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# GitHub token that can push branches and open pull requests on the repos in repos.json
GITHUB_TOKEN=github_pat_...
# Optional
# AUTOPILOT_MAX_TASKS=1
# AUTOPILOT_TASK_TIMEOUT_MIN=30
# AUTOPILOT_TASK_BUDGET_USD=5
# AUTOPILOT_MODEL=claude-opus-5-5
# AUTOPILOT_DIRECT=false   (turns off merging trivial changes straight to main)
# AUTOPILOT_TRIAGE_MODEL=claude-haiku-5-5
